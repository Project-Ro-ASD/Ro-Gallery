#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
if [[ "${GITHUB_ACTIONS:-}" == true ]]; then
    dnf install -y gcc-c++ cmake ninja-build qt6-qtbase-devel qt6-qtimageformats python3 desktop-file-utils appstream
fi
python3 tools/validate-roasd-app.py
bash -n run.sh install.sh tools/project-ci tools/build-rpm
desktop-file-validate ro-gallery.desktop
appstreamcli validate --no-net data/org.roasd.RoGallery.metainfo.xml
cmake -S . -B build-ci -G Ninja -DCMAKE_BUILD_TYPE=Release
cmake --build build-ci --parallel "${CMAKE_BUILD_PARALLEL_LEVEL:-2}"
ctest --test-dir build-ci --output-on-failure
STAGE="$(mktemp -d /tmp/ro-gallery-install.XXXXXX)"
trap 'rm -rf "$STAGE"' EXIT
DESTDIR="$STAGE" cmake --install build-ci --prefix /usr
test -x "$STAGE/usr/bin/ro-gallery"
desktop-file-validate "$STAGE/usr/share/applications/ro-gallery.desktop"
